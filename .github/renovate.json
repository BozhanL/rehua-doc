{
    "$schema": "https://docs.renovatebot.com/renovate-schema.json",
    "extends": [
        "config:best-practices",
        "helpers:disableTypesNodeMajor",
        "helpers:pinGitHubActionDigestsToSemver",
        ":semanticCommits",
        ":timezone(Pacific/Auckland)",

        "customManagers:dockerfileVersions",
        "customManagers:githubActionsVersions",

        ":assignAndReview(BozhanL)",

        "local>BozhanL/rehua-doc//.github/renovate/minimumReleaseAge",
        "local>BozhanL/rehua-doc//.github/renovate/automerge",
        "local>BozhanL/rehua-doc//.github/renovate/pip-compile"
    ],
    "ignorePresets": ["security:minimumReleaseAgeNpm"],

    "labels": ["dependencies", "{{{manager}}}"],
    "postUpdateOptions": ["npmDedupe", "npmInstallTwice"]
}
